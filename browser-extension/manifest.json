{
  "manifest_version": 3,
  "name": "WriteMate AI",
  "version": "0.1.0",
  "description": "Personal writing assistant — Fix Grammar, Rewrite, and more, right inside any text field. Talks only to your own local WriteMate AI server.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Ctrl+Shift+W",
        "mac": "Command+Shift+W"
      },
      "description": "Open WriteMate on the focused text field"
    }
  }
}
