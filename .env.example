# ============================================================
# WriteMate AI — environment configuration
# Copy this file to ".env" and fill in the values you need.
# ".env" is git-ignored and is never sent to the frontend.
# ============================================================

# Which port the local server listens on.
PORT=4173

# --- AI Provider ---
# Choose ONE provider to start with: "openai" | "anthropic" | "custom"
# You can also just leave this unset and pick the provider from the
# Settings page in the app — that's stored in data/settings.json instead.
WRITEMATE_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Custom / local OpenAI-compatible endpoint (e.g. Ollama, LM Studio).
# Example for Ollama: http://localhost:11434/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Generation defaults (can be overridden per-request from Settings) ---
DEFAULT_TEMPERATURE=0.4
# Keep this at 2048 or higher. The response is a JSON object containing the
# full corrected/improved text PLUS a list of issues/changes, so it needs
# more headroom than the visible reply length suggests — and some models
# (Gemini's 2.5/3.x flash family in particular) spend part of this budget on
# invisible "thinking" before writing the JSON. Too low a value here is the
# most common cause of a "could not parse a structured response" warning —
# it means the model's output got cut off mid-JSON.
DEFAULT_MAX_OUTPUT_TOKENS=2048

# --- Cost / abuse controls ---
# Max requests per minute, per process (this is a single-user local app,
# so this just guards against accidental runaway loops/costs).
RATE_LIMIT_PER_MINUTE=20
# Hard cap on how much text you can submit in one request (characters).
MAX_INPUT_CHARS=8000
# Timeout for the upstream AI call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=30000

# --- Troubleshooting (Phase E) ---
# GET /api/debug/errors and GET /api/debug/errors/:id let you look up the
# full technical detail behind a customer-facing error code + reference id
# (see PRIVACY.md — this never includes message text/context/API keys, only
# error metadata), so you can reproduce the same request in Postman. On by
# default, since this app only binds to 127.0.0.1 in personal mode. Set to
# "false" if you ever run this server as a shared backend other people can
# reach over the network (see "Self-hosting modes" in DEVELOPMENT.md).
WRITEMATE_ENABLE_DEBUG_ENDPOINT=true
